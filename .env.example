APP_NAME=Delivery Entregador API
ENVIRONMENT=development
LOG_LEVEL=INFO

POSTGRES_DB=delivery_entregador
POSTGRES_USER=delivery_user
POSTGRES_PASSWORD=delivery_password

# Use este DATABASE_URL para Docker Compose, pois o app roda na rede docker.
DATABASE_URL=postgresql+psycopg://delivery_user:delivery_password@postgres:5432/delivery_entregador

# Para rodar o app direto na maquina contra o Postgres publicado pelo Compose,
# use localhost no host do banco:
# DATABASE_URL=postgresql+psycopg://delivery_user:delivery_password@localhost:5432/delivery_entregador
